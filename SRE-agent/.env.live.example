SRE_MCP_BACKEND=live
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
LOKI_BASE_URL=http://127.0.0.1:3100
SRE_LOGS_BACKEND=loki
KUBECONFIG=/absolute/path/to/your/kubeconfig
KUBECTL_CONTEXT=your-cluster-context
OPS_API_TOKENS=local-admin-token|admin|Local Admin,viewer-demo-token|viewer|Viewer Demo,operator-demo-token|operator|Operator Demo,approver-demo-token|approver|Approver Demo
SRE_DEFAULT_API_TOKEN=local-admin-token
DATABASE_URL=postgresql+psycopg://sre_agent:sre_agent@postgres:5432/sre_agent
REDIS_URL=redis://redis:6379/0
EXECUTOR_BASE_URL=http://executor:8091
EXECUTOR_SHARED_TOKEN=sre-executor-local
GITOPS_REPO_DIR=/app/data/gitops_repo
