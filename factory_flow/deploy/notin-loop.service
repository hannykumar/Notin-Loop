[Unit]
Description=Notin-Loop SRE dark factory: agent, target service and dashboard (:8099, localhost)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__/factory_flow
Environment=PYTHONUNBUFFERED=1
# fresh demo state on every (re)start: target_service back at release-0, empty runs/
ExecStartPre=__APP_DIR__/factory_flow/scripts/reset.sh
ExecStart=__APP_DIR__/.venv/bin/python -m factory.cli start --ui 8099
# SIGTERM runs Agent.stop(): stable, canary, traffic and worktrees are cleaned up
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
